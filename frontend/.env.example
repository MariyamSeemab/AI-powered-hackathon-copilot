# Frontend build-time config (Vite).
# In dev, requests to /api are proxied to VITE_API_TARGET (see vite.config.js).
VITE_API_TARGET=http://localhost:4000

# In production, point the app at your deployed API Gateway base URL, e.g.:
# VITE_API_BASE=https://abc123.execute-api.us-east-1.amazonaws.com/api
