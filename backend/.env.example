# ---- Hackathon Copilot backend environment ----
# Copy to .env for local dev (never commit real values).

# Server
PORT=4000
CORS_ORIGIN=*

# Amazon Bedrock / Nova
# Set BEDROCK_ENABLED=false to run fully offline on the deterministic engine.
BEDROCK_ENABLED=true
BEDROCK_MODEL_ID=amazon.nova-lite-v1:0
AWS_REGION=us-east-1

# Project memory (Amazon DynamoDB)
# Leave DYNAMODB_TABLE empty to use the local JSON file store for dev.
DYNAMODB_TABLE=
# LOCAL_DB_PATH=./.data/projects.json

# AWS credentials are picked up from the standard chain
# (env vars, shared config, or the Lambda execution role).
# Do NOT hard-code AWS_ACCESS_KEY_ID / AWS_SECRET_ACCESS_KEY here in production.
